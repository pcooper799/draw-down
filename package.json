{
  "name": "draw-down",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop event app for ticket draw-downs with insurance.",
  "author": "Draw Down",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "electron:dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:vite": "tsc --noEmit && vite build",
    "dist": "npm run dist:win",
    "dist:win": "npm run build:vite && electron-builder --win nsis portable zip --x64",
    "dist:win:portable": "npm run build:vite && electron-builder --win portable zip --x64",
    "dist:dir": "npm run build:vite && electron-builder --win --x64 --dir",
    "release:repo": "node scripts/set-release-repo.mjs",
    "preview": "vite preview --port 43127 --host 127.0.0.1"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^37.5.1",
    "electron-builder": "^26.0.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
