{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.drawdown.app",
  "productName": "Draw Down",
  "copyright": "Copyright © Phillip Cooper",
  "asar": true,
  "directories": {
    "output": "release/${version}",
    "buildResources": "build"
  },
  "files": [
    "dist-electron",
    "dist"
  ],
  "extraMetadata": {
    "name": "draw-down",
    "main": "dist-electron/main/index.js",
    "author": {
      "name": "Phillip Cooper",
      "email": "pcooper799@gmail.com"
    }
  },
  "mac": {
    "artifactName": "${productName}-${version}-mac.${ext}",
    "target": [
      "dmg",
      "zip"
    ],
    "category": "public.app-category.entertainment"
  },
  "win": {
    "publisherName": ["Phillip Cooper"],
    "legalTrademarks": "Phillip Cooper",
    "artifactName": "${productName}-${version}-win-${arch}.${ext}",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Draw Down",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "installerHeaderIcon": "build/icon.ico",
    "uninstallDisplayName": "Draw Down",
    "artifactName": "${productName}-${version}-win-${arch}.${ext}"
  },
  "portable": {
    "artifactName": "${productName}-${version}-win-portable.${ext}"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "pcooper799",
      "repo": "draw-down",
      "releaseType": "release"
    }
  ]
}
